#!/usr/bin/env zsh
# Device/tunnel resolution used by LayerLens; derived from ipb (see ../LICENSE).
set -euo pipefail
[[ $# -eq 1 && -n "$1" ]] || { print -u2 "usage: device-resolve <device-identifier>"; exit 2; }
DEVICE_SELECTOR="$1"
XCODE="${DEVELOPER_DIR:-$(xcode-select -p)}"
DEVICECTL="${DEVICECTL:-/Library/Developer/PrivateFrameworks/CoreDevice.framework/Resources/bin/devicectl}"
[[ -x "$DEVICECTL" ]] || DEVICECTL="xcrun devicectl"
TUNNEL_WARMED=0

devicectl() {
  DEVELOPER_DIR="$XCODE" ${=DEVICECTL} "$@"
}

resolve_device() {
  local sel="${DEVICE_SELECTOR:-}"
  if [[ "$sel" =~ '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$' ]]; then
    print -r -- "$sel"
    return 0
  fi
  local json
  json="$(mktemp -t ipb-devices)"
  devicectl list devices --json-output "$json" --quiet >/dev/null 2>&1 || true
  local picked
  picked="$(python3 - "$json" "$sel" <<'PY'
import json, sys

HINT = 'select a device in LayerLens'

try:
    devices = json.load(open(sys.argv[1]))["result"]["devices"]
except Exception:
    print("could not list devices; is the CoreDevice package installed?", file=sys.stderr)
    sys.exit(3)
selector = sys.argv[2]

physical = []
for d in devices:
    hw = d.get("hardwareProperties", {}); cp = d.get("connectionProperties", {})
    if hw.get("reality", "physical") != "physical":
        continue
    physical.append({
        "id": d["identifier"],
        "udid": hw.get("udid", ""),
        "name": d.get("deviceProperties", {}).get("name", "?"),
        "model": hw.get("marketingName") or hw.get("productType", "?"),
        "transport": cp.get("transportType", "?"),
        "tunnel": cp.get("tunnelState", "?"),
    })

def bail(head, candidates):
    print(f"{head}; {HINT}:", file=sys.stderr)
    for c in candidates:
        print(f"  {c['id']}  {c['name']}  {c['model']}  ({c['transport']}, tunnel {c['tunnel']})",
              file=sys.stderr)
    sys.exit(3)

if selector:
    needle = selector.lower()
    # Most specific match first: whole id, then a prefix of one, then part of a name or model.
    for match in (lambda c: c["id"].lower() == needle or c["udid"].lower() == needle,
                  lambda c: c["id"].lower().startswith(needle),
                  lambda c: needle in c["name"].lower() or needle in c["model"].lower()):
        hits = [c for c in physical if match(c)]
        if len(hits) == 1:
            print(hits[0]["id"])
            sys.exit(0)
        if len(hits) > 1:
            bail(f'"{selector}" matches {len(hits)} devices', hits)
    bail(f'no device matches "{selector}"', physical)

usable = [c for c in physical if c["transport"] == "wired" or c["tunnel"] == "connected"]
if len(usable) == 1:
    print(usable[0]["id"])
elif physical:
    bail("no device is wired or tunnelled; connect one over USB", physical)
elif not usable:
    print("no physical device found; plug one in over USB, unlock it, and accept Trust",
          file=sys.stderr)
    sys.exit(3)
else:
    bail(f"{len(usable)} devices are connected", usable)
PY
)" || { rm -f "$json"; return 3; }
  rm -f "$json"
  print -r -- "$picked"
}

# Warm the CoreDevice tunnel once; any devicectl device action brings it up and it then persists.
warm_tunnel() {
  (( TUNNEL_WARMED )) && return 1
  TUNNEL_WARMED=1
  print -u2 "ipb: device tunnel not connected, warming it via devicectl..."
  devicectl device info details --device "$DEVICE" --timeout 30 >/dev/null 2>&1 || true
  return 0
}

# Resolve the CoreDevice tunnel (device IP, host IP, host utun interface) for the media stream.
# The device address is connectionProperties.tunnelIPAddress; the host address is the utun
# interface on this Mac that carries the same /64 (its ::2). Prints "hostIP utun deviceIP".
# mirror requests a fourth field, productType, from the same device JSON snapshot.
resolve_tunnel() {
  local json
  json="$(mktemp -t ipb-tunnel)"
  devicectl list devices --json-output "$json" --quiet >/dev/null 2>&1 || true
  local devip device_metadata product_type=""
  device_metadata="$(python3 - "$json" "$DEVICE" <<'PY2'
import json, sys
try:
    devs = json.load(open(sys.argv[1]))["result"]["devices"]
except Exception:
    sys.exit(3)
for d in devs:
    if d.get("identifier") == sys.argv[2]:
        ip = d.get("connectionProperties", {}).get("tunnelIPAddress")
        if ip:
            hardware = d.get("hardwareProperties")
            product = hardware.get("productType", "") if isinstance(hardware, dict) else ""
            print(ip + " " + (product if isinstance(product, str) else ""))
            sys.exit(0)
sys.exit(3)
PY2
)" || { rm -f "$json"; return 3; }
  rm -f "$json"
  devip="${device_metadata%% *}"
  [[ "$device_metadata" == *" "* ]] && product_type="${device_metadata#* }"
  [[ -n "$devip" ]] || return 3
  # device IP is <prefix>::1; find the host utun holding <prefix>::2
  local prefix="${devip%::*}"
  python3 - "$prefix" "${1:-}" "$product_type" <<'PY3'
import subprocess, sys
prefix = sys.argv[1].lower()
out = subprocess.run(["ifconfig"], capture_output=True, text=True).stdout
iface = None
for line in out.splitlines():
    if line and not line[0].isspace():
        iface = line.split(":")[0]
    s = line.strip()
    if s.startswith("inet6 ") and iface and iface.startswith("utun"):
        addr = s.split()[1].split("%")[0].lower()
        if addr.startswith(prefix + "::"):
            suffix = " " + sys.argv[3] if sys.argv[2] == "mirror" else ""
            print(f"{addr} {iface} {prefix}::1" + suffix)
            sys.exit(0)
sys.exit(3)
PY3
  return $?
}

DEVICE="$(resolve_device)" || exit 3
warm_tunnel >/dev/null 2>&1 || true
tun="$(resolve_tunnel mirror)" || { print -u2 "LayerLens: could not resolve the device tunnel (is the device connected?)"; exit 4; }
hostip="${tun%% *}"; rest="${tun#* }"; utun="${rest%% *}"; rest="${rest#* }"
devip="${rest%% *}"; product_type=""
[[ "$rest" == *" "* ]] && product_type="${rest#* }"
python3 - "$DEVICE" "$utun" "$hostip" "$devip" "$product_type" <<'RESOLVE_JSON'
import json, sys
print(json.dumps(sys.argv[1:]))
RESOLVE_JSON
